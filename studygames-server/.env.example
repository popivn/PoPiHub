# ---- Firebase Admin (server-side) ----
# Chọn 1 trong 3 cách để cấp Service Account cho firebase-admin:

# Cách 1 (dev): đường dẫn file JSON tải từ Firebase Console
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Cách 2 (deploy): paste nội dung JSON vào env (1 dòng, escape dấu ngoặc kép)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Cách 3: Application Default Credentials (đặt GOOGLE_APPLICATION_CREDENTIALS)
# Không cần set gì thêm, firebase-admin tự dùng ADC.

# Project ID (fallback nếu service account không chứa)
FIREBASE_PROJECT_ID=xianria-4f68a

# ---- JWT (server ký session token cho client) ----
# Production: random string >= 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-me

# ---- Server ----
PORT=3000

# ---- CORS ----
# Comma-separated list. Vite dev server mặc định :5000
CORS_ORIGIN=http://localhost:5000

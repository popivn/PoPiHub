{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/add-cron", "destination": "/api/add-cron" },
    { "source": "/update-cron", "destination": "/api/update-cron" },
    { "source": "/delete-cron", "destination": "/api/delete-cron" },
    { "source": "/add-scheduled-task", "destination": "/api/add-scheduled-task" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron-runner", "schedule": "*/5 * * * *" }
  ]
}

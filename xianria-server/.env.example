# JWT secret — dùng để ký/verify token
JWT_SECRET=xianria-dev-secret-change-me

# URL của client (mặc định: Vite dev server)
CLIENT_URL=http://localhost:5173

# Port server (mặc định: 3000)
PORT=3000

# Firebase Admin SDK — đường dẫn tới service account JSON
# Tạo từ Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

{
  "name": "pixijs-fps-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/server.js\" \"vite client --host 0.0.0.0\"",
    "server": "node server/server.js",
    "vite": "vite client --host 0.0.0.0",
    "build": "cd client && vite build",
    "preview": "vite preview client",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-redis": "^9.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pixi.js": "^8.0.0",
    "redis": "^6.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^9.2.4",
    "tailwindcss": "^4.3.3",
    "vite": "^5.2.0"
  }
}
